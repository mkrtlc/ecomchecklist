# E-Commerce Audit Backend Configuration
# Copy this file to .env.local and fill in your values

# ===========================================
# REQUIRED: Supabase Configuration
# ===========================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# OPTIONAL: Google PageSpeed Insights API
# ===========================================
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable the PageSpeed Insights API first
# Without this, the audit will still work but PageSpeed checks will be limited

GOOGLE_PAGESPEED_API_KEY=your-google-api-key

# ===========================================
# OPTIONAL: Browserless.io (for JS-rendered sites)
# ===========================================
# Get your API key from: https://www.browserless.io/
# Free tier: 6 hours/month
# Without this, the audit will use static HTML analysis

BROWSERLESS_API_KEY=your-browserless-api-key

# ===========================================
# OPTIONAL: Resend (for email reports)
# ===========================================
# Get your API key from: https://resend.com/api-keys
# Free tier: 100 emails/day
# Without this, email reports will not be sent

RESEND_API_KEY=your-resend-api-key

# ===========================================
# OPTIONAL: Base URL for email links
# ===========================================
# Set this to your production URL for email links to work correctly

NEXT_PUBLIC_BASE_URL=https://ecomchecklist.com
